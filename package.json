{
  "name": "minhagent",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev:web": "pnpm --filter @minhagent/web dev",
    "dev:webhook": "pnpm --filter @minhagent/webhook dev",
    "build": "pnpm --filter @minhagent/web build && pnpm --filter @minhagent/webhook build",
    "deploy:web": "pnpm --filter @minhagent/web deploy",
    "deploy:webhook": "pnpm --filter @minhagent/webhook deploy",
    "typecheck": "pnpm --filter @minhagent/web typecheck && pnpm --filter @minhagent/webhook typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
