{
  "name": "minhagent",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test --experimental-strip-types --import ./tests/register-alias.mjs tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke.mjs",
    "pack:assets": "bash scripts/pack-assets.sh",
    "deploy": "next build && bash scripts/pack-assets.sh && wrangler deploy",
    "dev:webhook": "pnpm --filter @minhagent/webhook dev",
    "deploy:webhook": "pnpm --filter @minhagent/webhook deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/gateway": "^4.0.46",
    "@ai-sdk/openai": "^4.0.36",
    "@ai-sdk/react": "^4.0.61",
    "@base-ui/react": "^1.7.0",
    "@browser-ai/core": "^3.0.0",
    "@browser-ai/web-llm": "^3.0.0",
    "@shadcn/react": "^0.3.0",
    "ai": "^7.0.58",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.14.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "latest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ],
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
