{
  "name": "minhagent",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev:web": "pnpm --filter @minhagent/web dev",
    "dev:webhook": "pnpm --filter @minhagent/webhook dev",
    "dev:minh": "pnpm --filter @minhagent/minh dev",
    "build": "pnpm --filter @minhagent/web build && pnpm --filter @minhagent/webhook build && pnpm --filter @minhagent/minh build",
    "deploy:web": "pnpm --filter @minhagent/web deploy",
    "deploy:webhook": "pnpm --filter @minhagent/webhook deploy",
    "deploy:minh": "pnpm --filter @minhagent/minh deploy",
    "test:minh": "pnpm --filter @minhagent/minh test",
    "typecheck": "pnpm --filter @minhagent/web typecheck && pnpm --filter @minhagent/webhook typecheck && pnpm --filter @minhagent/minh typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
