{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minh",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MINH", "class_name": "MinhAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MinhAgent"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
