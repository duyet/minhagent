{
  "name": "minhagent-web",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "minhagent.dev", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "702bec6d41ba43a0b8baab79c11f4b34"
    }
  ],
  "vars": {
    "PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_TODO"
  }
}
