{
  "name": "minhagent-web",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // No "main" here: @astrojs/cloudflare v13 generates dist/server/wrangler.json
  // and a .wrangler/deploy/config.json redirect that `wrangler deploy` follows.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "minhagent.dev", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "702bec6d41ba43a0b8baab79c11f4b34"
    }
  ],
  "vars": {
    "PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsubWluaGFnZW50LmRldiQ"
  }
}
