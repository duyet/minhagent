---
export const prerender = false;


const auth = Astro.locals.auth();
if (!auth.userId) {
  return Astro.redirect('/login');
}

const url = new URL(Astro.request.url);
const clientId = url.searchParams.get('client_id') ?? '';
const redirectUri = url.searchParams.get('redirect_uri') ?? '';
const scope = url.searchParams.get('scope') ?? '';
const state = url.searchParams.get('state') ?? '';
const codeChallenge = url.searchParams.get('code_challenge') ?? '';
const codeChallengeMethod = url.searchParams.get('code_challenge_method') ?? '';

const scopes = scope.split(' ').filter(Boolean);
const scopeLabels: Record<string, string> = {
  'anyrouter:read': 'Read your AnyRouter credentials',
  'profile:read': 'Read your profile',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Authorize — MinhAgent</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --bg: #0e0e11;
        --surface: #16161a;
        --border: #252530;
        --text: #e8e8f0;
        --muted: #7a7a8c;
        --accent: #7c6aff;
        --danger: #e54545;
        --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      }
      html { background: var(--bg); color: var(--text); font-family: var(--font); line-height: 1.6; }
      body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 2rem;
        width: 100%;
        max-width: 420px;
      }
      .app-icon {
        width: 52px; height: 52px;
        background: var(--accent);
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1.25rem;
      }
      h1 { font-size: 1.2rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.4rem; }
      .subtitle { color: var(--muted); font-size: 0.875rem; margin-bottom: 1.5rem; }
      .scope-list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.75rem; }
      .scope-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.875rem;
        color: var(--text);
      }
      .scope-check { color: #3c3; font-size: 1rem; }
      .actions { display: flex; gap: 0.75rem; }
      button {
        flex: 1;
        padding: 0.65rem;
        border-radius: 7px;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        border: none;
        transition: opacity 0.15s;
      }
      .btn-allow { background: var(--accent); color: #fff; }
      .btn-deny { background: transparent; color: var(--muted); border: 1px solid var(--border); }
      button:hover { opacity: 0.8; }
      .disclaimer { margin-top: 1.25rem; font-size: 0.78rem; color: var(--muted); text-align: center; }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="app-icon">⚡</div>
      <h1>MinhAgent.app wants access</h1>
      <p class="subtitle">This will allow <strong>MinhAgent.app</strong> to:</p>
      <ul class="scope-list">
        {
          scopes.map((s) => (
            <li class="scope-item">
              <span class="scope-check">✓</span>
              <span>{scopeLabels[s] ?? s}</span>
            </li>
          ))
        }
      </ul>
      <form method="POST" action="/api/oauth/decision" class="actions">
        <input type="hidden" name="client_id" value={clientId} />
        <input type="hidden" name="redirect_uri" value={redirectUri} />
        <input type="hidden" name="scope" value={scope} />
        <input type="hidden" name="state" value={state} />
        <input type="hidden" name="code_challenge" value={codeChallenge} />
        <input type="hidden" name="code_challenge_method" value={codeChallengeMethod} />
        <button type="submit" name="decision" value="deny" class="btn-deny">Deny</button>
        <button type="submit" name="decision" value="allow" class="btn-allow">Allow</button>
      </form>
      <p class="disclaimer">You can revoke this access at any time from your Dashboard.</p>
    </div>
  </body>
</html>
