---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';

const auth = Astro.locals.auth();
if (!auth.userId) {
  return Astro.redirect('/login');
}

const url = new URL(Astro.request.url);
const clientId = url.searchParams.get('client_id') ?? '';
const redirectUri = url.searchParams.get('redirect_uri') ?? '';
const scope = url.searchParams.get('scope') ?? '';
const state = url.searchParams.get('state') ?? '';
const codeChallenge = url.searchParams.get('code_challenge') ?? '';
const codeChallengeMethod = url.searchParams.get('code_challenge_method') ?? '';

const scopes = scope.split(' ').filter(Boolean);
const scopeLabels: Record<string, string> = {
  'anyrouter:read': 'Read your AnyRouter credentials',
  'profile:read': 'Read your profile',
};
---

<BaseLayout title="Authorize — MinhAgent" auth={true}>
  <div class="consent-wrapper">
    <div class="card consent-card">
      <div class="app-icon">⚡</div>
      <h1>MinhAgent.app wants access</h1>
      <p class="subtitle">This will allow <strong>MinhAgent.app</strong> to:</p>
      <ul class="scope-list">
        {
          scopes.map((s) => (
            <li class="scope-item">
              <span class="scope-check">✓</span>
              <span>{scopeLabels[s] ?? s}</span>
            </li>
          ))
        }
      </ul>
      <form method="POST" action="/api/oauth/decision" class="actions">
        <input type="hidden" name="client_id" value={clientId} />
        <input type="hidden" name="redirect_uri" value={redirectUri} />
        <input type="hidden" name="scope" value={scope} />
        <input type="hidden" name="state" value={state} />
        <input type="hidden" name="code_challenge" value={codeChallenge} />
        <input type="hidden" name="code_challenge_method" value={codeChallengeMethod} />
        <button type="submit" name="decision" value="deny" class="btn-deny">Deny</button>
        <button type="submit" name="decision" value="allow" class="btn-allow">Allow</button>
      </form>
      <p class="disclaimer">You can revoke this access at any time from your Dashboard.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .consent-wrapper {
    display: flex;
    justify-content: center;
    padding: 2rem 0;
  }

  .consent-card {
    width: 100%;
    max-width: 400px;
  }

  .app-icon {
    width: 48px;
    height: 48px;
    background: var(--accent);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .subtitle {
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .scope-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .scope-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
  }

  .scope-check {
    color: var(--success);
    font-size: 0.9rem;
  }

  .actions {
    display: flex;
    gap: 0.6rem;
  }

  .actions button {
    flex: 1;
    padding: 0.55rem;
    border-radius: var(--radius);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    border: none;
    transition: opacity 0.15s;
  }

  .btn-allow {
    background: var(--accent);
    color: #fff;
  }

  .btn-deny {
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--border) !important;
  }

  .actions button:hover {
    opacity: 0.85;
  }

  .disclaimer {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--muted);
    text-align: center;
  }
</style>
