---
import BaseLayout from '../layouts/BaseLayout.astro';

const features = [
  {
    title: 'Private by default',
    description:
      'Run on-device with Apple’s local foundation model, or route through AnyRouter — a secure LLM API that spreads requests across providers. Your data and keys stay yours.',
  },
  {
    title: 'Native Apple apps',
    description:
      'First-class macOS and iOS clients, signed in over OAuth 2.0 with PKCE.',
  },
];
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Early access</p>
    <h1>A private AI assistant for your Apple devices.</h1>
    <p class="lede">
      Run on-device or route through a secure gateway — your choice, one account.
    </p>
    <div class="actions">
      <a href="/dashboard" class="btn-primary">Open dashboard</a>
      <a href="/docs" class="btn-secondary">Read the docs</a>
    </div>
  </section>

  <section class="features" id="features">
    <ol class="feature-list">
      {
        features.map((f, i) => (
          <li class="feature">
            <span class="feature-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h2>{f.title}</h2>
              <p>{f.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: 3rem 0 2.5rem;
    max-width: 620px;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    font-weight: 680;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: 1rem;
    text-wrap: balance;
  }

  .lede {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 1.75rem;
    max-width: 540px;
  }

  .actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  /* Features */
  .features {
    padding: 1rem 0 2rem;
    border-top: 1px solid var(--border);
    margin-top: 1rem;
  }

  .feature-list {
    list-style: none;
    display: grid;
    gap: 0;
  }

  .feature {
    display: flex;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }
  .feature:last-child { border-bottom: none; }

  .feature-num {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent);
    padding-top: 0.15rem;
    flex-shrink: 0;
  }

  .feature h2 {
    font-size: 0.95rem;
    font-weight: 620;
    letter-spacing: -0.01em;
    margin-bottom: 0.3rem;
  }

  .feature p {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.6;
    max-width: 560px;
  }
</style>
