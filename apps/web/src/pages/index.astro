---
// Static by default — prerendered
const features = [
  {
    icon: '⚡',
    title: 'GitHub Automation',
    description:
      'Triage issues, review PRs, and automate your entire GitHub workflow with AI that understands your codebase.',
  },
  {
    icon: '🔀',
    title: 'LLM Gateway',
    description:
      'Route requests across models via AnyRouter. One API key, every model, intelligent cost-aware routing.',
  },
  {
    icon: '📱',
    title: 'Native Apps',
    description:
      'First-class Mac and iPhone apps. Deep OS integration — Shortcuts, Focus modes, notifications that matter.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MinhAgent — AI for your Mac and iPhone</title>
    <meta
      name="description"
      content="MinhAgent brings autonomous AI to your Mac and iPhone. GitHub automation, LLM gateway, native OS integration."
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg: #0e0e11;
        --surface: #16161a;
        --border: #252530;
        --text: #e8e8f0;
        --muted: #7a7a8c;
        --accent: #7c6aff;
        --accent-dim: rgba(124, 106, 255, 0.12);
        --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        --mono: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
      }

      html { background: var(--bg); color: var(--text); font-family: var(--font); line-height: 1.6; }

      body { min-height: 100vh; display: flex; flex-direction: column; }

      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }

      /* Nav */
      nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 2rem;
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        background: rgba(14, 14, 17, 0.9);
        backdrop-filter: blur(12px);
        z-index: 10;
      }

      .logo {
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--text);
      }

      .logo span { color: var(--accent); }

      nav ul {
        list-style: none;
        display: flex;
        gap: 2rem;
      }

      nav ul a {
        color: var(--muted);
        font-size: 0.9rem;
        transition: color 0.15s;
      }

      nav ul a:hover { color: var(--text); text-decoration: none; }

      .nav-cta {
        background: var(--accent);
        color: #fff !important;
        padding: 0.45rem 1rem;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        transition: opacity 0.15s;
      }

      .nav-cta:hover { opacity: 0.85; }

      /* Hero */
      .hero {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 7rem 2rem 5rem;
        max-width: 860px;
        margin: 0 auto;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: var(--accent-dim);
        color: var(--accent);
        border: 1px solid rgba(124, 106, 255, 0.25);
        padding: 0.3rem 0.75rem;
        border-radius: 100px;
        font-size: 0.8rem;
        font-weight: 500;
        margin-bottom: 2rem;
        letter-spacing: 0.02em;
      }

      h1 {
        font-size: clamp(2.4rem, 6vw, 4rem);
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        color: var(--text);
      }

      h1 em {
        font-style: normal;
        color: var(--accent);
      }

      .hero-sub {
        font-size: 1.125rem;
        color: var(--muted);
        max-width: 520px;
        line-height: 1.7;
        margin-bottom: 2.5rem;
      }

      .hero-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        justify-content: center;
      }

      .btn-primary {
        background: var(--accent);
        color: #fff;
        padding: 0.7rem 1.5rem;
        border-radius: 7px;
        font-size: 0.95rem;
        font-weight: 500;
        transition: opacity 0.15s;
      }

      .btn-primary:hover { opacity: 0.85; text-decoration: none; }

      .btn-secondary {
        background: var(--surface);
        color: var(--text);
        border: 1px solid var(--border);
        padding: 0.7rem 1.5rem;
        border-radius: 7px;
        font-size: 0.95rem;
        font-weight: 500;
        transition: border-color 0.15s;
      }

      .btn-secondary:hover { border-color: var(--accent); text-decoration: none; }

      /* Features */
      .features {
        padding: 5rem 2rem;
        max-width: 1040px;
        margin: 0 auto;
        width: 100%;
      }

      .section-label {
        text-align: center;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 1rem;
      }

      .section-title {
        text-align: center;
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        margin-bottom: 0.75rem;
      }

      .section-sub {
        text-align: center;
        color: var(--muted);
        font-size: 1rem;
        max-width: 480px;
        margin: 0 auto 3.5rem;
      }

      .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .feature-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.75rem;
        transition: border-color 0.2s;
      }

      .feature-card:hover { border-color: rgba(124, 106, 255, 0.4); }

      .feature-icon {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        display: block;
      }

      .feature-card h3 {
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin-bottom: 0.5rem;
      }

      .feature-card p {
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.65;
      }

      /* Divider */
      .divider {
        border: none;
        border-top: 1px solid var(--border);
        max-width: 1040px;
        margin: 0 auto;
      }

      /* Footer */
      footer {
        padding: 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        max-width: 1040px;
        margin: 0 auto;
        width: 100%;
      }

      footer p { color: var(--muted); font-size: 0.85rem; }

      footer nav ul {
        gap: 1.5rem;
      }

      footer nav ul a {
        font-size: 0.85rem;
      }

      @media (max-width: 600px) {
        nav ul { display: none; }
        footer { flex-direction: column; text-align: center; }
      }
    </style>
  </head>
  <body>
    <nav>
      <span class="logo">Minh<span>Agent</span></span>
      <ul>
        <li><a href="#features">Features</a></li>
        <li><a href="/login">Sign in</a></li>
        <li><a href="/dashboard" class="nav-cta">Dashboard</a></li>
      </ul>
    </nav>

    <main>
      <section class="hero">
        <div class="badge">✦ Early Access</div>
        <h1>AI that works for you,<br /><em>on every device</em></h1>
        <p class="hero-sub">
          MinhAgent automates your GitHub workflow, routes LLM calls intelligently, and runs
          natively on Mac and iPhone — no cloud lock-in, no wasted tokens.
        </p>
        <div class="hero-actions">
          <a href="/dashboard" class="btn-primary">Get started</a>
          <a href="#features" class="btn-secondary">See features →</a>
        </div>
      </section>

      <hr class="divider" />

      <section class="features" id="features">
        <p class="section-label">Capabilities</p>
        <h2 class="section-title">Everything you need, nothing you don't</h2>
        <p class="section-sub">
          Purpose-built tools that fit into your existing workflow instead of replacing it.
        </p>
        <div class="feature-grid">
          {
            features.map((f) => (
              <div class="feature-card">
                <span class="feature-icon">{f.icon}</span>
                <h3>{f.title}</h3>
                <p>{f.description}</p>
              </div>
            ))
          }
        </div>
      </section>
    </main>

    <hr class="divider" />

    <footer>
      <p>© 2026 MinhAgent. Built with care.</p>
      <nav>
        <ul>
          <li><a href="/login">Sign in</a></li>
          <li><a href="/dashboard">Dashboard</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
