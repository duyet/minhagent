---
import BaseLayout from '../layouts/BaseLayout.astro';

const features = [
  {
    title: 'GitHub automation',
    description:
      'A webhook receiver routes repository events into Cloudflare Workflows — triage, labels, and PR checks run without a server to babysit.',
  },
  {
    title: 'LLM gateway',
    description:
      'Connect one AnyRouter key and reach every model. Requests route by cost and availability; your key never leaves your account.',
  },
  {
    title: 'Native apps',
    description:
      'A first-class Mac and iPhone client authenticates over OAuth 2.0 with PKCE — Shortcuts, Focus, and notifications included.',
  },
];
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Early access</p>
    <h1>AI tooling that runs where you work.</h1>
    <p class="lede">
      MinhAgent wires your GitHub events, an LLM gateway, and native Apple apps into one
      account — built on Cloudflare Workers, not a rented backend.
    </p>
    <div class="actions">
      <a href="/dashboard" class="btn-primary">Open dashboard</a>
      <a href="/docs" class="btn-secondary">Read the docs</a>
    </div>
  </section>

  <section class="features" id="features">
    <ol class="feature-list">
      {
        features.map((f, i) => (
          <li class="feature">
            <span class="feature-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h2>{f.title}</h2>
              <p>{f.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="connect">
    <div class="connect-head">
      <h2>Connect in one call</h2>
      <p>Native clients authenticate with OAuth 2.0 PKCE and read your gateway config.</p>
    </div>
    <pre class="snippet"><code><span class="c-comment"># after the PKCE handshake</span>
<span class="c-cmd">curl</span> https://minhagent.dev/api/me/anyrouter \
  -H <span class="c-str">"Authorization: Bearer $TOKEN"</span></code></pre>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: 3rem 0 2.5rem;
    max-width: 620px;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    font-weight: 680;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: 1rem;
    text-wrap: balance;
  }

  .lede {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 1.75rem;
    max-width: 540px;
  }

  .actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  /* Features */
  .features {
    padding: 1rem 0 2rem;
    border-top: 1px solid var(--border);
    margin-top: 1rem;
  }

  .feature-list {
    list-style: none;
    display: grid;
    gap: 0;
  }

  .feature {
    display: flex;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }
  .feature:last-child { border-bottom: none; }

  .feature-num {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent);
    padding-top: 0.15rem;
    flex-shrink: 0;
  }

  .feature h2 {
    font-size: 0.95rem;
    font-weight: 620;
    letter-spacing: -0.01em;
    margin-bottom: 0.3rem;
  }

  .feature p {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.6;
    max-width: 560px;
  }

  /* Connect */
  .connect {
    padding: 1.5rem 0 1rem;
  }

  .connect-head h2 {
    font-size: 1.05rem;
    font-weight: 640;
    letter-spacing: -0.02em;
    margin-bottom: 0.3rem;
  }
  .connect-head p {
    color: var(--muted);
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .snippet {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1rem 1.1rem;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--text);
  }
  .snippet code { font-family: inherit; }
  .c-comment { color: var(--muted); }
  .c-cmd { color: var(--accent); }
  .c-str { color: var(--success); }
</style>
