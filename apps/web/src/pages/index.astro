---
import BaseLayout from '../layouts/BaseLayout.astro';

const features = [
  {
    icon: '⚡',
    title: 'GitHub Automation',
    description:
      'Triage issues, review PRs, and automate your entire GitHub workflow with AI that understands your codebase.',
  },
  {
    icon: '🔀',
    title: 'LLM Gateway',
    description:
      'Route requests across models via AnyRouter. One API key, every model, intelligent cost-aware routing.',
  },
  {
    icon: '📱',
    title: 'Native Apps',
    description:
      'First-class Mac and iPhone apps. Deep OS integration — Shortcuts, Focus modes, notifications that matter.',
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="badge">✦ Early Access</div>
    <h1>AI that works for you,<br /><em>on every device</em></h1>
    <p class="hero-sub">
      MinhAgent automates your GitHub workflow, routes LLM calls intelligently, and runs
      natively on Mac and iPhone — no cloud lock-in, no wasted tokens.
    </p>
    <div class="hero-actions">
      <a href="/dashboard" class="btn-primary">Get started</a>
      <a href="#features" class="btn-secondary">See features →</a>
    </div>
  </section>

  <section class="features" id="features">
    <p class="section-label">Capabilities</p>
    <h2 class="section-title">Everything you need, nothing you don't</h2>
    <p class="section-sub">
      Purpose-built tools that fit into your existing workflow instead of replacing it.
    </p>
    <div class="feature-grid">
      {
        features.map((f) => (
          <div class="card feature-card">
            <span class="feature-icon">{f.icon}</span>
            <h3>{f.title}</h3>
            <p>{f.description}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    text-align: center;
    padding: 3.5rem 0 2.5rem;
    max-width: 680px;
    margin: 0 auto;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--accent-dim);
    color: var(--accent);
    border: 1px solid var(--accent-border);
    padding: 0.25rem 0.7rem;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .hero-sub {
    font-size: 1rem;
    color: var(--muted);
    max-width: 480px;
    margin: 0 auto 1.75rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Features */
  .features {
    padding: 2.5rem 0 1rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .section-label {
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .section-title {
    text-align: center;
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .section-sub {
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
    max-width: 440px;
    margin: 0 auto 2rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .feature-card {
    transition: border-color 0.2s;
  }
  .feature-card:hover {
    border-color: var(--accent-border);
  }

  .feature-icon {
    font-size: 1.3rem;
    margin-bottom: 0.75rem;
    display: block;
  }

  .feature-card h3 {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .feature-card p {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  @media (max-width: 600px) {
    .hero { padding: 2rem 0 1.5rem; }
  }
</style>
