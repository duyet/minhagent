---
export const prerender = false;
import { SignIn } from '@clerk/astro/components';
import BaseLayout from '../layouts/BaseLayout.astro';

// Preserve OAuth state (PKCE challenge, client_id, …) across Clerk sign-in.
// Only same-origin targets are allowed to prevent open redirects.
const redirectParam = Astro.url.searchParams.get('redirect_url');
let forceRedirectUrl: string | undefined;
if (redirectParam) {
  try {
    const parsed = new URL(redirectParam, Astro.url.origin);
    if (parsed.origin === Astro.url.origin) {
      forceRedirectUrl = parsed.pathname + parsed.search;
    }
  } catch {
    // ignore malformed redirect_url
  }
}
---

<BaseLayout title="Sign in — MinhAgent">
  <div class="signin-center">
    <SignIn forceRedirectUrl={forceRedirectUrl} />
  </div>
</BaseLayout>

<style>
  .signin-center {
    display: flex;
    justify-content: center;
    padding: 2rem 0;
  }
</style>
