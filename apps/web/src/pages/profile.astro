---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { getOAuthKV } from '../lib/runtime';
import { resolveToken, type GrantRecord } from '../lib/oauth';

const auth = Astro.locals.auth();
if (!auth.userId) {
  return Astro.redirect('/login');
}

const { userId } = auth;
const user = await Astro.locals.currentUser();
const displayName = user?.fullName ?? user?.emailAddresses?.[0]?.emailAddress ?? userId;
const email = user?.primaryEmailAddress?.emailAddress ?? user?.emailAddresses?.[0]?.emailAddress ?? null;
const avatar = user?.imageUrl ?? null;
const memberSince = user?.createdAt ? new Date(user.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : null;

const kv = getOAuthKV();

// Each grant is one native-app session. Resolve its access token to read the
// scopes (permissions) it was issued with.
const grantList = await kv.list({ prefix: `grant:${userId}:` });
const sessions = await Promise.all(
  grantList.keys.map(async (k) => {
    const tokenId = k.name.slice(`grant:${userId}:`.length);
    let scope = '';
    const raw = await kv.get(k.name);
    if (raw) {
      try {
        const grant = JSON.parse(raw) as GrantRecord;
        const token = await resolveToken(kv, grant.accessToken);
        scope = token?.scope ?? '';
      } catch {
        // ignore malformed grant
      }
    }
    return { tokenId, scopes: scope.split(' ').filter(Boolean) };
  }),
);

const scopeLabels: Record<string, string> = {
  'anyrouter:read': 'Read your AnyRouter credentials',
  'profile:read': 'Read your profile',
};

// Distinct permissions granted across all sessions.
const permissions = [...new Set(sessions.flatMap((s) => s.scopes))];

const statusMessages: Record<string, string> = { revoked: 'App access revoked.' };
const statusParam = Astro.url.searchParams.get('status') ?? '';
const notice = statusMessages[statusParam] ?? null;
---

<BaseLayout title="Profile — MinhAgent" auth={true} fullWidth={true}>
  <div class="profile">
    <div class="profile-header">
      <h1>Profile</h1>
      <p class="sub">Your account, permissions, and connected sessions.</p>
    </div>

    {notice && <p class="notice notice-success" role="status">{notice}</p>}

    <section>
      <h2>Basic information</h2>
      <div class="card identity">
        {avatar
          ? <img class="avatar" src={avatar} alt="" width="48" height="48" />
          : <span class="avatar avatar-fallback" aria-hidden="true">{displayName.charAt(0).toUpperCase()}</span>}
        <dl class="fields">
          <div><dt>Name</dt><dd>{displayName}</dd></div>
          {email && <div><dt>Email</dt><dd>{email}</dd></div>}
          <div><dt>User ID</dt><dd class="mono">{userId}</dd></div>
          {memberSince && <div><dt>Member since</dt><dd>{memberSince}</dd></div>}
        </dl>
      </div>
    </section>

    <section>
      <h2>Permissions</h2>
      <div class="card">
        {
          permissions.length > 0 ? (
            <ul class="perm-list">
              {permissions.map((p) => (
                <li class="perm-item">
                  <span class="scope-check" aria-hidden="true">✓</span>
                  <span>{scopeLabels[p] ?? p}</span>
                  <code class="scope-code">{p}</code>
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">No permissions granted. Connecting MinhAgent.app via OAuth grants scoped access here.</p>
          )
        }
      </div>
    </section>

    <section>
      <h2>App sessions</h2>
      <div class="card">
        {
          sessions.length > 0 ? (
            <ul class="session-list">
              {sessions.map((s) => (
                <li class="session-item">
                  <span class="dot" aria-hidden="true" />
                  <div class="session-meta">
                    <span class="session-name">MinhAgent.app</span>
                    <span class="session-id">session {s.tokenId.slice(0, 8)}…</span>
                  </div>
                  <span class="session-scopes">{s.scopes.length} {s.scopes.length === 1 ? 'permission' : 'permissions'}</span>
                  <form
                    method="POST"
                    action="/api/oauth/revoke"
                    onsubmit="return confirm('Revoke this session?');"
                  >
                    <input type="hidden" name="token_id" value={s.tokenId} />
                    <button type="submit" class="btn-danger-ghost">Revoke</button>
                  </form>
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">No active app sessions.</p>
          )
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .profile { max-width: 720px; margin: 0 auto; }
  .profile-header { margin-bottom: 2rem; }
  h1 { font-size: 1.4rem; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 0.2rem; }
  .sub { color: var(--muted); font-size: 0.85rem; }

  section { margin-bottom: 2rem; }
  h2 { font-size: 0.95rem; font-weight: 600; letter-spacing: -0.01em; margin-bottom: 0.75rem; }
  .card p { color: var(--muted); font-size: 0.85rem; }

  .notice { font-size: 0.85rem; padding: 0.5rem 0.75rem; border-radius: var(--radius); margin-bottom: 1.5rem; }
  .notice-success { color: var(--text); background: var(--accent-dim); border: 1px solid var(--accent-border); }

  /* Identity */
  .identity { display: flex; gap: 1rem; align-items: center; }
  .avatar { border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .avatar-fallback {
    width: 48px; height: 48px; display: grid; place-items: center;
    background: var(--accent); color: var(--bg); font-weight: 700; font-size: 1.1rem;
  }
  .fields { display: grid; grid-template-columns: auto 1fr; gap: 0.35rem 1.5rem; flex: 1; }
  .fields > div { display: contents; }
  .fields dt { color: var(--muted); font-size: 0.8rem; }
  .fields dd { font-size: 0.85rem; }
  .fields dd.mono { font-family: var(--mono); font-size: 0.78rem; word-break: break-all; }

  /* Permissions */
  .perm-list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .perm-item { display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; }
  .scope-check { color: var(--text); }
  .scope-code {
    margin-left: auto; font-family: var(--mono); font-size: 0.75rem; color: var(--muted);
    background: var(--surface-2); padding: 0.1rem 0.4rem; border-radius: 5px;
  }

  /* Sessions */
  .session-list { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
  .session-item {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.55rem 0.7rem; background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); font-size: 0.85rem;
  }
  .session-meta { display: flex; flex-direction: column; line-height: 1.3; }
  .session-name { font-weight: 600; }
  .session-id { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); }
  .session-scopes { margin-left: auto; color: var(--muted); font-size: 0.78rem; }
  .dot { width: 7px; height: 7px; background: var(--text); border-radius: 50%; flex-shrink: 0; }

  .btn-danger-ghost {
    background: none; color: var(--danger); border: 1px solid transparent;
    border-radius: var(--radius); padding: 0.25rem 0.6rem; font-size: 0.8rem;
    font-family: inherit; cursor: pointer; transition: border-color 0.15s;
  }
  .btn-danger-ghost:hover { border-color: var(--danger); }
  .session-item form { display: block; }

  @media (max-width: 560px) {
    .identity { flex-direction: column; align-items: flex-start; }
  }
</style>
