---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';

const auth = Astro.locals.auth();
if (!auth.userId) {
  return Astro.redirect('/login');
}

const { userId } = auth;
const kv = Astro.locals.runtime.env.OAUTH_KV;

// Load connected apps (grants)
const grantListRaw = await kv.list({ prefix: `grant:${userId}:` });
const grants = grantListRaw.keys.map((k) => k.name.split(':')[2]);

// Load stored gateway key (masked)
const gatewayRaw = await kv.get(`gateway:${userId}`);
const gateway = gatewayRaw ? JSON.parse(gatewayRaw) : null;
---

<BaseLayout title="Dashboard — MinhAgent" auth={true} fullWidth={true}>
  <div class="dashboard">
    <div class="dashboard-header">
      <h1>Dashboard</h1>
      <p class="greeting">Signed in as user {userId}</p>
    </div>

    <section id="connected-apps">
      <h2>Connected Apps</h2>
      <div class="card">
        {
          grants.length > 0 ? (
            <ul class="grant-list">
              {grants.map((g) => (
                <li class="grant-item">
                  <span class="dot" />
                  <span>MinhAgent.app — token {g.slice(0, 8)}…</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">No connected apps yet. Connect MinhAgent.app via OAuth to see grants here.</p>
          )
        }
      </div>
    </section>

    <section id="llm-gateway">
      <h2>LLM Gateway</h2>
      <div class="card">
        {gateway && (
          <p class="current-key">
            Current key: {gateway.provider} — {(gateway.apiKey as string).slice(0, 8)}…
          </p>
        )}
        <form method="POST" action="/api/gateway">
          <div>
            <label>
              Provider
              <select name="provider">
                <option value="anyrouter">AnyRouter</option>
                <option value="openrouter">OpenRouter</option>
              </select>
            </label>
          </div>
          <div>
            <label>
              API Key
              <input type="password" name="apiKey" placeholder="sk-…" required />
            </label>
          </div>
          <button type="submit" class="btn-primary">Save key</button>
        </form>
      </div>
    </section>

    <section id="profile">
      <h2>Profile settings</h2>
      <div class="card">
        <p class="empty">Profile management is handled by Clerk. Visit your Clerk user profile to update name, email, or connected accounts.</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .dashboard {
    max-width: 720px;
    margin: 0 auto;
  }

  .dashboard-header {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.2rem;
  }

  .greeting {
    color: var(--muted);
    font-size: 0.85rem;
  }

  section {
    margin-bottom: 2rem;
  }

  h2 {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
  }

  .card p {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .empty {
    color: var(--muted);
    font-size: 0.85rem;
  }

  /* Grant list */
  .grant-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .grant-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    background: var(--accent-dim);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius);
    font-size: 0.85rem;
  }

  .dot {
    width: 7px;
    height: 7px;
    background: var(--success);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Gateway form */
  form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: gateway ? 0 : 0;
  }

  .current-key {
    font-size: 0.8rem;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.35rem 0.7rem;
    font-family: monospace;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 600px) {
    .dashboard { padding: 0; }
  }
</style>
