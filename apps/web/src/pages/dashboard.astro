---
export const prerender = false;


const auth = Astro.locals.auth();
if (!auth.userId) {
  return Astro.redirect('/login');
}

const { userId } = auth;
const kv = Astro.locals.runtime.env.OAUTH_KV;

// Load connected apps (grants)
const grantListRaw = await kv.list({ prefix: `grant:${userId}:` });
const grants = grantListRaw.keys.map((k) => k.name.split(':')[2]);

// Load stored gateway key (masked)
const gatewayRaw = await kv.get(`gateway:${userId}`);
const gateway = gatewayRaw ? JSON.parse(gatewayRaw) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard — MinhAgent</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --bg: #0e0e11;
        --surface: #16161a;
        --border: #252530;
        --text: #e8e8f0;
        --muted: #7a7a8c;
        --accent: #7c6aff;
        --danger: #f05;
        --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      }
      html { background: var(--bg); color: var(--text); font-family: var(--font); line-height: 1.6; }
      body { display: flex; min-height: 100vh; }

      /* Sidebar */
      aside {
        width: 220px;
        flex-shrink: 0;
        border-right: 1px solid var(--border);
        padding: 1.5rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .logo { font-size: 1rem; font-weight: 600; letter-spacing: -0.02em; padding: 0.25rem 0.5rem; margin-bottom: 1rem; }
      .logo span { color: var(--accent); }
      .nav-item {
        display: block;
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        color: var(--muted);
        font-size: 0.875rem;
        text-decoration: none;
        transition: background 0.15s, color 0.15s;
      }
      .nav-item:hover, .nav-item.active { background: rgba(124,106,255,0.1); color: var(--text); }

      /* Main */
      main { flex: 1; padding: 2.5rem; max-width: 800px; }
      h1 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 0.25rem; }
      .greeting { color: var(--muted); font-size: 0.9rem; margin-bottom: 2.5rem; }

      /* Sections */
      section { margin-bottom: 2.5rem; }
      h2 { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; margin-bottom: 1rem; }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 1.25rem;
      }
      .card p { color: var(--muted); font-size: 0.875rem; }
      .grant-list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
      .grant-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.75rem;
        background: rgba(124,106,255,0.06);
        border: 1px solid rgba(124,106,255,0.15);
        border-radius: 6px;
        font-size: 0.875rem;
      }
      .grant-item .dot { width: 8px; height: 8px; background: #3c3; border-radius: 50%; flex-shrink: 0; }

      /* Form */
      form { display: flex; flex-direction: column; gap: 1rem; }
      label { font-size: 0.85rem; color: var(--muted); }
      input[type="text"], input[type="password"], select {
        width: 100%;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.6rem 0.75rem;
        color: var(--text);
        font-size: 0.9rem;
        font-family: inherit;
        margin-top: 0.35rem;
        transition: border-color 0.15s;
      }
      input:focus, select:focus { outline: none; border-color: var(--accent); }
      .btn {
        align-self: flex-start;
        background: var(--accent);
        color: #fff;
        border: none;
        padding: 0.6rem 1.25rem;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: opacity 0.15s;
      }
      .btn:hover { opacity: 0.85; }
      .current-key {
        font-size: 0.8rem;
        color: var(--muted);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 5px;
        padding: 0.4rem 0.75rem;
        font-family: monospace;
      }
    </style>
  </head>
  <body>
    <aside>
      <p class="logo">Minh<span>Agent</span></p>
      <a href="/dashboard" class="nav-item active">Overview</a>
      <a href="/login" class="nav-item">Sign out</a>
    </aside>
    <main>
      <h1>Dashboard</h1>
      <p class="greeting">Signed in as user {userId}</p>

      <section id="connected-apps">
        <h2>Connected Apps</h2>
        <div class="card">
          {
            grants.length > 0 ? (
              <ul class="grant-list">
                {grants.map((g) => (
                  <li class="grant-item">
                    <span class="dot" />
                    <span>MinhAgent.app — token {g.slice(0, 8)}…</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p>No connected apps yet. Connect MinhAgent.app via OAuth to see grants here.</p>
            )
          }
        </div>
      </section>

      <section id="llm-gateway">
        <h2>LLM Gateway</h2>
        <div class="card">
          {gateway && (
            <p style="margin-bottom:1rem;">
              Current key: <span class="current-key">{gateway.provider} — {(gateway.apiKey as string).slice(0, 8)}…</span>
            </p>
          )}
          <form method="POST" action="/api/gateway">
            <div>
              <label>
                Provider
                <select name="provider">
                  <option value="anyrouter">AnyRouter</option>
                  <option value="openrouter">OpenRouter</option>
                </select>
              </label>
            </div>
            <div>
              <label>
                API Key
                <input type="password" name="apiKey" placeholder="sk-…" required />
              </label>
            </div>
            <button type="submit" class="btn">Save key</button>
          </form>
        </div>
      </section>

      <section id="profile">
        <h2>Profile settings</h2>
        <div class="card">
          <p>Profile management is handled by Clerk. Visit your Clerk user profile to update name, email, or connected accounts.</p>
        </div>
      </section>
    </main>
  </body>
</html>
