---
import { UserButton } from '@clerk/astro/components';

interface Props {
  title?: string;
  description?: string;
  auth?: boolean;
  fullWidth?: boolean;
}

const {
  title = 'MinhAgent — AI for your Mac and iPhone',
  description = 'MinhAgent automates your GitHub workflow, routes LLM calls, and runs natively on Mac and iPhone.',
  auth = false,
  fullWidth = false,
} = Astro.props;

const authData = auth ? Astro.locals.auth() : null;
const signedIn = auth && authData?.userId;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%23111111'/><text x='50' y='72' font-size='62' font-family='-apple-system,system-ui,sans-serif' font-weight='700' fill='white' text-anchor='middle'>M</text></svg>" />
    <script is:inline>
      // Apply stored theme before paint to avoid a flash. Absent = follow system.
      (() => {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body data-fullwidth={fullWidth || undefined}>
    <nav>
      <a href="/" class="logo">
        <span class="logo-mark">M</span>
        <span class="logo-text">minhagent</span>
      </a>
      <div class="nav-right">
        <a href="/docs" class="nav-link">Docs</a>
        <button type="button" id="theme-toggle" class="icon-btn" aria-label="Toggle theme" title="Toggle theme">
          <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        {signedIn ? (
          <>
            <a href="/dashboard" class="btn-primary btn-sm">Dashboard</a>
            <UserButton />
          </>
        ) : (
          <a href="/login" class="btn-ghost">Sign in</a>
        )}
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; 2026 MinhAgent</p>
      <div class="footer-links">
        <a href="/docs">Docs</a>
        <a href="https://github.com/duyet/minhagent">GitHub</a>
      </div>
    </footer>

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg: #ffffff;
        --surface: #f6f6f6;
        --surface-2: #ededed;
        --border: #e2e2e2;
        --text: #111111;
        --muted: #6a6a6a;
        --accent: #111111;
        --accent-hover: #000000;
        --accent-dim: rgba(0, 0, 0, 0.05);
        --accent-border: rgba(0, 0, 0, 0.18);
        --success: #6a6a6a;
        --danger: #c0392b;
        --mono: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Menlo', 'Consolas', monospace;
        --font: var(--mono);
        --radius: 6px;
        --radius-lg: 8px;
        color-scheme: light dark;
      }

      /* Dark palette: shared by system preference (unless forced light) and
         the explicit data-theme="dark" override from the toggle. */
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #0a0a0a;
          --surface: #141414;
          --surface-2: #1c1c1c;
          --border: #262626;
          --text: #ededed;
          --muted: #888888;
          --accent: #ededed;
          --accent-hover: #ffffff;
          --accent-dim: rgba(255, 255, 255, 0.06);
          --accent-border: rgba(255, 255, 255, 0.2);
          --success: #888888;
          --danger: #e57373;
        }
      }

      :root[data-theme='dark'] {
        --bg: #0a0a0a;
        --surface: #141414;
        --surface-2: #1c1c1c;
        --border: #262626;
        --text: #ededed;
        --muted: #888888;
        --accent: #ededed;
        --accent-hover: #ffffff;
        --accent-dim: rgba(255, 255, 255, 0.06);
        --accent-border: rgba(255, 255, 255, 0.2);
        --success: #888888;
        --danger: #e57373;
      }

      html {
        background: var(--bg);
        color: var(--text);
        font-family: var(--font);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }

      /* Nav */
      nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.5rem;
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        background: var(--bg);
        z-index: 10;
      }

      .logo {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text);
        text-decoration: none;
      }
      .logo:hover { text-decoration: none; }
      .logo-mark {
        display: grid;
        place-items: center;
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: var(--accent);
        color: var(--bg);
        font-size: 0.8rem;
        font-weight: 700;
        line-height: 1;
      }
      .logo-text {
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        font-family: var(--mono);
      }

      .nav-right {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .nav-link {
        color: var(--muted);
        font-size: 0.85rem;
        font-weight: 500;
        padding: 0.35rem 0.5rem;
      }
      .nav-link:hover { color: var(--text); text-decoration: none; }

      /* Icon button (theme toggle) — borderless, minimal */
      .icon-btn {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: var(--radius);
        background: none;
        border: none;
        color: var(--muted);
        cursor: pointer;
        transition: color 0.15s, background 0.15s;
      }
      .icon-btn:hover { color: var(--text); background: var(--surface); }
      .icon-btn:active { transform: scale(0.92); }
      .icon-btn svg { display: block; }
      /* Show sun in dark mode (click → light), moon otherwise.
         Scoped under .icon-btn to outrank `.icon-btn svg { display: block }`. */
      .icon-btn .icon-sun { display: none; }
      .icon-btn .icon-moon { display: block; }
      :root[data-theme='dark'] .icon-btn .icon-sun { display: block; }
      :root[data-theme='dark'] .icon-btn .icon-moon { display: none; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) .icon-btn .icon-sun { display: block; }
        :root:not([data-theme='light']) .icon-btn .icon-moon { display: none; }
      }

      /* Buttons */
      .btn-primary {
        background: var(--accent);
        color: var(--bg);
        padding: 0.45rem 1rem;
        border-radius: var(--radius);
        font-size: 0.85rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
        transition: background 0.15s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
      }
      .btn-primary:hover { background: var(--accent-hover); text-decoration: none; }

      .btn-sm { padding: 0.35rem 0.8rem; font-size: 0.8rem; }

      .btn-ghost {
        background: none;
        color: var(--muted);
        padding: 0.35rem 0.75rem;
        border-radius: var(--radius);
        font-size: 0.85rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
        transition: color 0.15s;
      }
      .btn-ghost:hover { color: var(--text); }

      .btn-secondary {
        background: var(--surface);
        color: var(--text);
        border: 1px solid var(--border);
        padding: 0.45rem 1rem;
        border-radius: var(--radius);
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: border-color 0.15s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
      }
      .btn-secondary:hover { border-color: var(--accent); text-decoration: none; }

      /* Main */
      main {
        flex: 1;
        padding: 2rem 1.5rem;
        max-width: 960px;
        margin: 0 auto;
        width: 100%;
      }

      body[data-fullwidth] main {
        max-width: none;
      }

      /* Footer */
      footer {
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid var(--border);
        max-width: 960px;
        margin: 0 auto;
        width: 100%;
      }

      footer p { color: var(--muted); font-size: 0.8rem; }

      .footer-links {
        display: flex;
        gap: 1rem;
      }
      .footer-links a {
        color: var(--muted);
        font-size: 0.8rem;
      }
      .footer-links a:hover { color: var(--text); }

      /* Shared card */
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 1.25rem;
      }

      /* Form elements */
      input, select, textarea {
        width: 100%;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 0.5rem 0.75rem;
        color: var(--text);
        font-size: 0.875rem;
        font-family: inherit;
        transition: border-color 0.15s;
      }
      input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: var(--accent);
      }

      label {
        display: block;
        font-size: 0.8rem;
        color: var(--muted);
        margin-bottom: 0.25rem;
      }

      @media (max-width: 600px) {
        nav { padding: 0.6rem 1rem; }
        main { padding: 1.25rem 1rem; }
        footer { flex-direction: column; gap: 0.5rem; text-align: center; }
      }
    </style>

    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const systemDark = () => window.matchMedia('(prefers-color-scheme: dark)').matches;
        const current = () => document.documentElement.dataset.theme || (systemDark() ? 'dark' : 'light');
        btn.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('theme', next);
        });
      })();
    </script>
  </body>
</html>
