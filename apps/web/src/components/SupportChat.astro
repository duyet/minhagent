---
// Floating Support button + slide-over AI panel. Appears on every page via
// BaseLayout. Answers are produced server-side by /api/support, which calls
// the router using the signed-in user's own gateway key. Guests see a prompt
// to sign in / configure their gateway.
---
<div id="support-root">
  <button type="button" id="support-fab" class="support-fab" aria-label="Open support chat" aria-expanded="false">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
    <span>Support</span>
  </button>

  <section id="support-panel" class="support-panel" hidden aria-label="MinhAgent support chat">
    <header class="support-head">
      <div class="support-head-text">
        <p class="support-title">Support</p>
        <p class="support-sub">Ask about MinhAgent — via your gateway.</p>
      </div>
      <button type="button" id="support-close" class="support-close" aria-label="Close support chat">&times;</button>
    </header>

    <div id="support-messages" class="support-messages" aria-live="polite">
      <div class="support-greet">Hi! Ask me anything about MinhAgent, the gateway, or the native apps.</div>
    </div>

    <form id="support-form" class="support-form">
      <textarea id="support-input" name="message" rows="1" placeholder="Ask a question…" autocomplete="off" required></textarea>
      <button type="submit" id="support-send" class="support-send">Send</button>
    </form>
  </section>
</div>

<style is:global>
  /* Global (not scoped) because the chat messages are created at runtime in
     the client script and would otherwise miss Astro's scope attribute. All
     classes are prefixed `support-` to avoid collisions. */
  #support-root { --support-z: 40; }

  .support-fab {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: var(--support-z);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    border: 1px solid var(--accent);
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
    transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
  }
  .support-fab:hover { transform: translateY(-1px); box-shadow: 0 10px 26px rgba(0, 0, 0, 0.22); }
  .support-fab:active { transform: translateY(0) scale(0.97); }
  .support-fab[aria-expanded='true'] { opacity: 0; pointer-events: none; transform: scale(0.8); }

  .support-panel {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: calc(var(--support-z) + 1);
    width: min(380px, calc(100vw - 2rem));
    height: min(540px, calc(100vh - 2.5rem));
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.28);
    overflow: hidden;
    animation: support-pop 0.16s ease-out;
  }
  /* `.support-panel { display: flex }` above outranks the UA `[hidden]`
     rule, so the panel would show on load. Restore hidden semantics. */
  .support-panel[hidden] { display: none; }
  @keyframes support-pop {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .support-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.7rem 0.85rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .support-title { font-size: 0.85rem; font-weight: 700; letter-spacing: -0.01em; }
  .support-sub { font-size: 0.7rem; color: var(--muted); margin-top: 0.1rem; }
  .support-close {
    display: grid; place-items: center;
    width: 26px; height: 26px;
    border: none; background: none; color: var(--muted);
    font-size: 1.2rem; line-height: 1; cursor: pointer; border-radius: var(--radius);
  }
  .support-close:hover { color: var(--text); background: var(--surface-2); }

  .support-messages {
    flex: 1;
    overflow-y: auto;
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .support-greet { font-size: 0.78rem; color: var(--muted); line-height: 1.5; }
  .support-messages .msg { font-size: 0.8rem; line-height: 1.5; padding: 0.5rem 0.7rem; border-radius: var(--radius); max-width: 90%; word-wrap: break-word; }
  .support-messages .msg-user { align-self: flex-end; background: var(--accent); color: var(--bg); }
  .support-messages .msg-assistant { align-self: flex-start; background: var(--surface); border: 1px solid var(--border); color: var(--text); }
  .support-messages .msg-assistant.is-error { color: var(--danger); border-color: var(--danger); background: rgba(255, 69, 58, 0.06); }
  .msg-action { display: inline-block; margin-top: 0.45rem; font-size: 0.72rem; font-weight: 600; text-decoration: underline; }

  .support-form {
    display: flex;
    gap: 0.4rem;
    padding: 0.6rem;
    border-top: 1px solid var(--border);
    background: var(--surface);
  }
  .support-form textarea {
    flex: 1;
    resize: none;
    max-height: 120px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.45rem 0.6rem;
    font-family: inherit;
    font-size: 0.8rem;
    color: var(--text);
    line-height: 1.4;
  }
  .support-form textarea:focus { outline: none; border-color: var(--accent); }
  .support-send {
    align-self: stretch;
    background: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: var(--radius);
    padding: 0 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .support-send:hover { opacity: 0.88; }
  .support-send:disabled { opacity: 0.5; cursor: default; }

  @media (max-width: 600px) {
    .support-fab { right: 1rem; bottom: 1rem; }
    .support-panel { right: 0.75rem; bottom: 0.75rem; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('support-root');
    if (!root) return;
    const fab = document.getElementById('support-fab');
    const panel = document.getElementById('support-panel');
    const closeBtn = document.getElementById('support-close');
    const form = document.getElementById('support-form') as HTMLFormElement | null;
    const input = document.getElementById('support-input') as HTMLTextAreaElement | null;
    const messages = document.getElementById('support-messages');
    const send = document.getElementById('support-send') as HTMLButtonElement | null;
    if (!fab || !panel || !closeBtn || !form || !input || !messages || !send) return;

    const open = () => {
      panel.hidden = false;
      fab.setAttribute('aria-expanded', 'true');
      input.focus();
    };
    const hide = () => {
      panel.hidden = true;
      fab.setAttribute('aria-expanded', 'false');
      fab.focus();
    };
    fab.addEventListener('click', () => (panel.hidden ? open() : hide()));
    closeBtn.addEventListener('click', hide);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) hide();
    });

    const scrollDown = () => {
      messages.scrollTop = messages.scrollHeight;
    };
    const addMsg = (role: 'user' | 'assistant', text: string, opts?: { error?: boolean; action?: { label: string; href: string } }) => {
      const el = document.createElement('div');
      el.className = `msg msg-${role}${opts?.error ? ' is-error' : ''}`;
      const p = document.createElement('p');
      p.textContent = text;
      el.appendChild(p);
      if (opts?.action) {
        const a = document.createElement('a');
        a.href = opts.action.href;
        a.textContent = opts.action.label;
        a.className = 'msg-action';
        el.appendChild(a);
      }
      messages.appendChild(el);
      scrollDown();
      return el;
    };
    const setMsg = (el: HTMLElement, text: string, opts?: { error?: boolean; action?: { label: string; href: string } }) => {
      el.querySelector('p')!.textContent = text;
      el.classList.toggle('is-error', !!opts?.error);
      const old = el.querySelector('.msg-action');
      if (old) old.remove();
      if (opts?.action) {
        const a = document.createElement('a');
        a.href = opts.action.href;
        a.textContent = opts.action.label;
        a.className = 'msg-action';
        el.appendChild(a);
      }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const message = input.value.trim();
      if (!message || send.disabled) return;

      addMsg('user', message);
      input.value = '';
      input.style.height = 'auto';
      send.disabled = true;
      const thinking = addMsg('assistant', 'Thinking…');

      try {
        const res = await fetch('/api/support', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message }),
        });
        const data = (await res.json()) as { reply?: string; error?: string; action?: { label: string; href: string } };
        if (!res.ok || (!data.reply && !data.error)) {
          setMsg(thinking, data.error || 'Something went wrong. Please try again.', { error: true });
        } else {
          setMsg(thinking, data.reply || data.error || 'No answer.', { action: data.action });
        }
      } catch {
        setMsg(thinking, 'Network error — please try again.', { error: true });
      } finally {
        send.disabled = false;
        input.focus();
      }
    });

    input.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 120) + 'px';
    });
  })();
</script>
