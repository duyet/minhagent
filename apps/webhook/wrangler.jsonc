{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minhagent-webhook",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "workflows": [
    {
      "binding": "GITHUB_EVENT_WORKFLOW",
      "name": "minhagent_github_event_workflow",
      "class_name": "GitHubEventWorkflow"
    }
  ]
}
